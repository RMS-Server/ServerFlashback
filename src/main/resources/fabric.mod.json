{
  "schemaVersion": 1,
  "id": "$id",
  "version": "$version",
  "name": "ServerFlashback",
  "description": "Server-side replay recording mod producing FlashBack-compatible replay files",
  "authors": [
    "Trirrin"
  ],
  "contact": {
    "sources": "https://github.com/Trirrin/ServerFlashback"
  },
  "license": "GPL-3.0",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.serverflashback.ServerFlashback"
    ]
  },
  "mixins": [
    "${id}.mixins.json"
  ],
  "accessWidener": "${id}.accesswidener",
  "depends": {
    "fabricloader": ">=$loader_version",
    "minecraft": "$minecraft_version",
    "fabric-api": "*"
  }
}
